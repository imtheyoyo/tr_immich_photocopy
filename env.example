# Photocopy settings - fill out the details and save alongside the compose file.
# Read by the container (env_file) and, where UGOS supports it, by the compose file itself.

# --- compose (build path, network, port) - the compose file has these same values as fallbacks

PHOTOCOPY_SRC=/volume2/scripts/immich/tr-photocopy
IMMICH_NETWORK=immich_default
BIND_IP=192.168.0.1
PORT=8791

# --- immich
IMMICH_URL=http://immich_server:2283

# One line per account: IMMICH_KEY_<NAME>=<key>. 
# NAME is what the dropdown displays (case sensitive).
# Key permissions: asset.upload, asset.read, user.read, tag.create, tag.asset, album.create, albumAsset.create
IMMICH_KEY_Main=
# IMMICH_KEY_Account2=
# IMMICH_KEY_Account3=

# Account selected on first start (afterwards the last one picked is remembered)
IMMICH_DEFAULT=MAIN

# Accounts that only match - Upload / Upgrade are off (external-library accounts)
# IMMICH_NO_UPLOAD=Account2,Account3

# --- immich Postgres
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# --- paths (comma separated list)
# Where scanning, browsing, copying, moving and deleting are allowed
ALLOWED_ROOTS=/volume1

# Copy / move / new-folder destinations refused (immich/NextCloud/Git db folders etc)
BLOCKED_DEST=/volume1/appdata,/volume2/appdata,/volume2/docker

# Folders immich reads - files are never moved, recycled or deleted from these
LIBRARY_PATHS=/volume1/appdata/immich

# --- misc
TZ=Europe/London
CACHE_DIR=/cache
